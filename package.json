{
  "name": "santoro-logs",
  "version": "0.0.1",
  "description": "A Quasar Project",
  "productName": "logs",
  "author": "Leonel Flores <leonellechuga38@gmail.com>",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint -c ./eslint.config.js \"./src*/**/*.{js,cjs,mjs,vue}\"",
    "format": "prettier --write \"**/*.{js,vue,scss,html,md,json}\" --ignore-path .gitignore",
    "test": "echo \"No test specified\" && exit 0",
    "dev": "quasar dev",
    "build": "quasar build",
    "build:prod": "quasar build",
    "start": "quasar dev",
    "postinstall": "quasar prepare",
    "mobileInstall": "quasar mode add capacitor",
    "mobile-build": "quasar build -m capacitor -T android",
    "mobile-build-dev": "node scripts/mobile-build-dev.mjs",
    "mobile-sync": "cd src-capacitor && npx cap sync android",
    "mobile-open": "cd src-capacitor && npx cap open android",
    "mobile-device": "npm run mobile-build-dev && cd src-capacitor && npx cap run android --target RZCXB11DAYX --no-sync",
    "mobile-device-prod": "npm run mobile-build && cd src-capacitor && npx cap run android --target RZCXB11DAYX --no-sync",
    "mobile-dev": "node scripts/mobile-dev.mjs",
    "mobile-live": "npm run mobile-dev",
    "mobile": "npm run mobile-device"
  },
  "dependencies": {
    "@capacitor/android": "^7.5.0",
    "@capacitor/app": "^7.1.2",
    "@capacitor/cli": "^7.5.0",
    "@capacitor/core": "^7.5.0",
    "@capacitor/status-bar": "^7.0.5",
    "@nazka/map-gl-js-spiderfy": "^2.0.0",
    "@quasar/extras": "^1.16.4",
    "@stomp/stompjs": "^7.2.1",
    "apexcharts": "^5.10.3",
    "axios": "^1.10.0",
    "chart.js": "^4.5.0",
    "chartjs-plugin-datalabels": "^2.2.0",
    "esri-leaflet": "^3.0.17",
    "file-saver": "^2.0.5",
    "jspdf": "^3.0.3",
    "jspdf-autotable": "^5.0.2",
    "jwt-decode": "^4.0.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "maplibre-gl": "^5.19.0",
    "pinia": "^3.0.3",
    "pinia-plugin-persistedstate": "^4.4.1",
    "quasar": "^2.16.0",
    "vue": "^3.4.18",
    "vue-i18n": "^11.3.2",
    "vue-router": "^4.0.0",
    "vue3-apexcharts": "^1.11.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@quasar/app-vite": "^2.1.0",
    "@vue/eslint-config-prettier": "^10.1.0",
    "autoprefixer": "^10.4.2",
    "eslint": "^9.14.0",
    "eslint-plugin-vue": "^9.30.0",
    "globals": "^15.12.0",
    "postcss": "^8.4.14",
    "prettier": "^3.3.3",
    "vite-plugin-checker": "^0.9.0"
  },
  "engines": {
    "node": "^28 || ^26 || ^24 || ^22 || ^20 || ^18",
    "npm": ">= 6.13.4",
    "yarn": ">= 1.21.1"
  }
}
