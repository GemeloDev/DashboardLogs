# ════════════════════════════════════════════════════════════════
# VARIABLES DE ENTORNO - COMUNES
# ════════════════════════════════════════════════════════════════
# Variables compartidas entre todos los ambientes
# Se sobrescriben por .env.development o .env.production

# Nombre de la aplicación
APP_NAME=Dashboard Logs Santoro

# Versión de la app
APP_VERSION=1.0.0

# Timeout para peticiones HTTP (en milisegundos)
API_TIMEOUT=30000

# Socket topic
SOCKET_TOPIC=/topic/qr-login
