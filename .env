# ════════════════════════════════════════════════════════════════
# VARIABLES DE ENTORNO - PRODUCCIÓN
# ════════════════════════════════════════════════════════════════

# URL del backend de producción
API_BASE_URL=https://api-logs.grupo-santoro.com.mx/api

# WebSocket para producción
WS_BASE_URL=wss://api-logs.grupo-santoro.com.mx/ws

# Modo de debug
DEBUG_MODE=false

# Nombre del ambiente
NODE_ENV=production

# Nombre de la app
APP_NAME=Dashboard Logs Santoro

# Versión de la app
APP_VERSION=1.0.0

# Timeout para peticiones HTTP (en milisegundos)
API_TIMEOUT=30000

# Socket topic
SOCKET_TOPIC=/topic/qr-login
