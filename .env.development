# ════════════════════════════════════════════════════════════════
# VARIABLES DE ENTORNO - DESARROLLO
# ════════════════════════════════════════════════════════════════
# Este archivo se usa cuando ejecutas: quasar dev
# NO subir a producción - solo para desarrollo local

# URL del backend de desarrollo (puede ser localhost o servidor de staging)
API_BASE_URL=https://dashboard-api.grupo-santoro.com.mx/api

# URL alternativa si usas el servidor de staging
# API_BASE_URL=https://dashboard-api.grupo-santoro.com.mx/api

# WebSocket para desarrollo
WS_BASE_URL=wss://dashboard-api.grupo-santoro.com.mx/ws

# Modo de debug
DEBUG_MODE=true

# Nombre del ambiente
NODE_ENV=development
