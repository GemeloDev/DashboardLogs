# ════════════════════════════════════════════════════════════════
# VARIABLES DE ENTORNO - PRODUCCIÓN
# ════════════════════════════════════════════════════════════════
# Este archivo se usa cuando ejecutas: quasar build
# Estas son las URLs reales del servidor en producción

# URL del backend de producción
API_BASE_URL=https://api-logs.grupo-santoro.com.mx/api

# WebSocket para producción
WS_BASE_URL=wss://api-logs.grupo-santoro.com.mx/ws

# Modo de debug (siempre false en producción)
DEBUG_MODE=false

# Nombre del ambiente
NODE_ENV=production
