# ════════════════════════════════════════════════════════════════
# EJEMPLO DE VARIABLES DE ENTORNO
# ════════════════════════════════════════════════════════════════
# 
# Este archivo es una REFERENCIA de todas las variables disponibles.
# NO se usa directamente - es solo documentación.
# 
# Para configurar tu ambiente local:
#   1. Copia este archivo como .env.local
#   2. Modifica los valores según tu configuración
#   3. .env.local NO se sube a git (está en .gitignore)
# 
# ════════════════════════════════════════════════════════════════

# ─── API Backend ─────────────────────────────────────────────────
# URL del servidor backend
API_BASE_URL=https://dashboard-api.grupo-santoro.com.mx/api

# ─── WebSocket ───────────────────────────────────────────────────
# URL del servidor WebSocket
# Si no se especifica, se calcula automáticamente desde API_BASE_URL
WS_BASE_URL=wss://dashboard-api.grupo-santoro.com.mx/ws

# Tópico de WebSocket para login QR
SOCKET_TOPIC=/topic/qr-login

# ─── Configuración de la Aplicación ─────────────────────────────
# Nombre de la aplicación
APP_NAME=Dashboard Logs Santoro

# Versión de la aplicación
APP_VERSION=1.0.0

# Timeout para peticiones HTTP (en milisegundos)
API_TIMEOUT=30000

# ─── Modo de Desarrollo ─────────────────────────────────────────
# Habilita logs de debug en la consola
DEBUG_MODE=false

# Ambiente de ejecución (development, production, test)
NODE_ENV=production
